PORT=4000
JWT_SECRET=change-this-secret
# CORS: en desarrollo cualquier origen localhost/127.0.0.1/192.168.* se acepta solo.
# Solo define CORS_ORIGINS si despliegas con dominios propios.
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace_dev
# Alternativa si prefieres variables separadas:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=marketplace_dev

# API de códigos postales (Postali/SEPOMEX, sin API key). Configurable por si cambias de proveedor.
CP_API_URL=https://postali.app/api/v1/mx/cp/

# Google Drive (OAuth2 con refresh token sobre la cuenta institucional)
# Pasos en README: crear proyecto en Google Cloud Console, habilitar Google Drive API,
# generar OAuth Client ID/Secret (tipo "Desktop app"), obtener el refresh token con un flujo OAuth2,
# y compartir la carpeta "Marketplace-Mexico" con la cuenta al05-050-0322@utdelacosta.edu.mx
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
