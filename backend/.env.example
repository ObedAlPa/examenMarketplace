PORT=4000
JWT_SECRET=change-this-secret
# CORS: en desarrollo cualquier origen localhost/127.0.0.1/192.168.* se acepta solo.
# Solo define CORS_ORIGINS si despliegas con dominios propios.
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgres://postgres:010604@localhost:5432/marketplace_dev
# Alternativa si prefieres variables separadas:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=marketplace_dev

# API de códigos postales (Postali/SEPOMEX, sin API key). Configurable por si cambias de proveedor.
CP_API_URL=https://postali.app/api/v1/mx/cp/

# Google Drive (OAuth2 con refresh token) — CONFIGURA TU PROPIA CUENTA
# Pasos completos en README.md → "Configuración de Google Drive"
# 1. Crea proyecto en Google Cloud Console, habilita Google Drive API
# 2. Crea OAuth Client ID tipo "Desktop app" → obtén Client ID y Client Secret
# 3. Obtén refresh token: node scripts/get-refresh-token.js (o usa OAuth Playground)
# 4. En TU Drive crea carpeta "AutoPartes" y subcarpetas → copia su ID
# 5. Pon tus 4 valores abajo (NUNCA subas credenciales reales a Git público)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
