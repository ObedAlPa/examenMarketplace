{
  "name": "tenomerca",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "setup": "npm install && node scripts/setup.js",
    "prestart": "node scripts/setup.js",
    "start": "npm run dev",
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "migrate": "npm --prefix backend run migrate",
    "seed": "npm --prefix backend run seed"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
